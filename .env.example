# GitHub: a fine-grained PAT (contents:write, pull_requests:write, webhooks) on your repositories
LOOP_GITHUB_TOKEN=github_pat_xxx
# openssl rand -hex 32
LOOP_GITHUB_WEBHOOK_SECRET=change-me
# A bot from @BotFather; get the chat_id from @userinfobot
LOOP_TELEGRAM_BOT_TOKEN=123456:ABC
LOOP_TELEGRAM_CHAT_ID=123456789
# The sandboxd API from inside the docker network (check the service name: docker compose ps in the sandboxd directory)
LOOP_SANDBOXD_URL=http://sandboxd:9090
# POST /v1/api-keys, or the sandboxd console
LOOP_SANDBOXD_API_KEY=sbx_xxx
# The id from POST /v1/git-credentials (see docs/deploy.md, step 4)
LOOP_GIT_CREDENTIAL_ID=cred_xxx
# Public webhook host (Caddy)
LOOP_WEBHOOK_HOST=loop.example.com
# IANA time zone for progress-card timestamps; defaults to UTC
# LOOP_TZ=Asia/Almaty

# --- Phase 4a: approval pause and Telegram control ---
# CSV of Telegram user ids allowed to press run buttons (get yours from @userinfobot)
LOOP_TELEGRAM_ADMIN_IDS=123456789
# Any random string (A-Za-z0-9_-), e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOOP_TELEGRAM_WEBHOOK_SECRET=change-me
# External base URL of the orchestrator WITH scheme (usually https://$LOOP_WEBHOOK_HOST);
# together with the secret it enables setWebhook on startup
LOOP_PUBLIC_URL=https://loop.example.com
# Sandbox/preview lifetime while a run awaits approval, minutes
# LOOP_PREVIEW_TTL_MINUTES=120
# Window each keepalive buys against sandboxd's idle reaper, minutes. Refreshed
# on every poll tick, so it only has to outlast a poll gap or a short restart —
# and it caps how long a sandbox lingers after the orchestrator stops watching.
# Must stay below sandboxd's SANDBOXD_KEEPALIVE_MAX_SECONDS (default 24h).
# LOOP_KEEPALIVE_MINUTES=30

# --- Agent tracing (OpenTelemetry -> Jaeger) ---
# Empty = tracing off: no session copy out of the sandbox, no exec calls, no
# export. Set it to turn tracing on; the compose file already ships Jaeger.
# Spec: docs/superpowers/specs/2026-08-06-agent-tracing-otel.md
LOOP_OTLP_ENDPOINT=http://jaeger:4318
# Cap on every exported content field (prompt previews, tool args, tool results).
# Full tool output runs to megabytes of repository code.
# LOOP_TRACE_PREVIEW_CHARS=500
# How long Jaeger keeps the spans, in HOURS (336 = 14 days). The per-Run cost
# rollup in SQLite outlives it.
# LOOP_TRACE_RETENTION_HOURS=336
# service.name on every exported span
# LOOP_TRACE_SERVICE_NAME=loop-orchestrator
# Override the model price table (USD per 1M tokens) without a deploy:
# LOOP_MODEL_PRICES={"claude-opus-5":{"input":5,"cache_write":6.25,"cache_read":0.5,"output":25}}
