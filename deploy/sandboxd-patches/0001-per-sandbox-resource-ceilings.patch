diff --git a/control-plane/internal/sandboxspec/limits.go b/control-plane/internal/sandboxspec/limits.go
new file mode 100644
index 0000000..7547564
--- /dev/null
+++ b/control-plane/internal/sandboxspec/limits.go
@@ -0,0 +1,34 @@
+package sandboxspec
+
+import "os"
+
+// Limits are the per-sandbox resource ceilings.
+//
+// They used to be literals repeated in the create path and the recreate path,
+// with no --cpus among them: a sandbox could take every core the host had, and
+// a memory ceiling larger than the host's RAM is not a ceiling at all. Reading
+// them from the environment keeps both paths in step and lets an operator size
+// a sandbox to the machine it runs on.
+//
+// The defaults reproduce the original literals exactly, so an install that sets
+// nothing behaves as it did before.
+type Limits struct {
+	CPUs       string // --cpus; "" = no ceiling, the original behaviour
+	Memory     string // --memory
+	MemorySwap string // --memory-swap; equal to Memory disables swap entirely
+}
+
+func LimitsFromEnv() Limits {
+	return Limits{
+		CPUs:       os.Getenv("SANDBOXD_CPUS"),
+		Memory:     envOrDefault("SANDBOXD_MEMORY", "10g"),
+		MemorySwap: envOrDefault("SANDBOXD_MEMORY_SWAP", "10g"),
+	}
+}
+
+func envOrDefault(key, def string) string {
+	if v := os.Getenv(key); v != "" {
+		return v
+	}
+	return def
+}
